# GemGuard Docker Configuration
#
# Copy this file to .env and customize as needed:
#   cp .env.example .env

# Port to expose GemGuard (default: 9292)
# Change this to avoid conflicts with other services
GEMGUARD_PORT=9292

# Rails master key for production
# Generate with: bin/rails secret
# Or copy from config/master.key
RAILS_MASTER_KEY=your_master_key_here
