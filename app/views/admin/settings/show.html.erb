<div class="mb-6">
  <h1 class="text-3xl font-bold">Settings</h1>
  <p class="text-base-content/70">Configure GemGuard behavior</p>
</div>

<div class="card bg-base-100 shadow">
  <div class="card-body">
    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-6" do |f| %>
      <div class="form-control">
        <label class="label">
          <span class="label-text font-bold">Quarantine Period (hours)</span>
        </label>
        <input type="number" name="quarantine_hours" value="<%= @settings[:quarantine_hours] %>" min="0" max="720" class="input input-bordered w-full max-w-xs" />
        <label class="label">
          <span class="label-text-alt text-base-content/70">
            New gem versions will be quarantined for this many hours before becoming available.
            Current: <%= pluralize(@settings[:quarantine_hours], "hour") %> (<%= (@settings[:quarantine_hours] / 24.0).round(1) %> days)
          </span>
        </label>
      </div>

      <div class="form-control">
        <label class="label cursor-pointer justify-start gap-4">
          <input type="hidden" name="cache_gems" value="0" />
          <input type="checkbox" name="cache_gems" value="1" <%= "checked" if @settings[:cache_gems] %> class="checkbox checkbox-primary" />
          <div>
            <span class="label-text font-bold">Cache Gems Locally</span>
            <p class="text-sm text-base-content/70">Store downloaded gems in local storage for offline access and faster subsequent downloads.</p>
          </div>
        </label>
      </div>

      <div class="form-control">
        <label class="label">
          <span class="label-text font-bold">Upstream Source</span>
        </label>
        <input type="url" name="upstream_source" value="<%= @settings[:upstream_source] %>" class="input input-bordered w-full max-w-md" />
        <label class="label">
          <span class="label-text-alt text-base-content/70">
            The RubyGems server to proxy from. Default: https://rubygems.org
          </span>
        </label>
      </div>

      <div class="pt-4">
        <button type="submit" class="btn btn-primary">Save Settings</button>
      </div>
    <% end %>
  </div>
</div>

<div class="card bg-base-100 shadow mt-6">
  <div class="card-body">
    <h2 class="card-title">Baseline Database</h2>
    <p class="text-sm text-base-content/70 mb-4">
      The baseline contains all gem versions that existed before GemGuard installation.
      Only gems released after the baseline are quarantined.
    </p>

    <% if Setting.baseline_imported? %>
      <% baseline_source = Setting.get(:baseline_source) || "csv" %>
      <% source_label = case baseline_source
        when "rubygems_dump" then "Full RubyGems dump"
        when "specs" then "RubyGems specs"
        else "CSV baseline"
      end %>
      <div class="alert alert-success mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <div>
          <h3 class="font-bold">Baseline Imported</h3>
          <p class="text-sm">
            Imported at <%= Setting.baseline_imported_at.strftime("%Y-%m-%d %H:%M:%S %Z") %>
            <span class="badge badge-ghost badge-sm ml-2"><%= source_label %></span>
          </p>
        </div>
      </div>

      <div class="stats shadow mb-4">
        <div class="stat">
          <div class="stat-title">Approved</div>
          <div class="stat-value text-success"><%= number_with_delimiter(GemVersion.approved.count) %></div>
        </div>
        <div class="stat">
          <div class="stat-title">Blocked</div>
          <div class="stat-value text-error"><%= number_with_delimiter(GemVersion.blocked.count) %></div>
        </div>
        <div class="stat">
          <div class="stat-title">Quarantined</div>
          <div class="stat-value text-warning"><%= number_with_delimiter(GemVersion.quarantined.count) %></div>
        </div>
      </div>
    <% else %>
      <div class="alert alert-warning mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        <div>
          <h3 class="font-bold">Baseline Not Imported</h3>
          <p class="text-sm">Import the baseline to enable proper quarantine filtering.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
        <div class="card bg-primary/10 border-2 border-primary">
          <div class="card-body">
            <div class="flex items-center gap-2">
              <h3 class="card-title text-lg">From Specs</h3>
              <span class="badge badge-primary badge-sm">Recommended</span>
            </div>
            <p class="text-sm text-base-content/70 mb-4">
              Download and parse RubyGems specs files (~30MB). Gets all gem names and versions, and saves specs for immediate use.
            </p>
            <%= form_with url: import_baseline_admin_settings_path, method: :post do %>
              <input type="hidden" name="source" value="specs">
              <label class="label cursor-pointer justify-start gap-2 mb-2">
                <input type="checkbox" name="include_prerelease" value="1" class="checkbox checkbox-sm checkbox-primary" />
                <span class="label-text text-sm">Include prereleases</span>
              </label>
              <button type="submit" class="btn btn-primary btn-sm">
                Import from Specs
              </button>
            <% end %>
            <p class="text-xs text-base-content/50 mt-2">Takes 2-5 minutes</p>
          </div>
        </div>

        <div class="card bg-base-200">
          <div class="card-body">
            <h3 class="card-title text-lg">Full Dump</h3>
            <p class="text-sm text-base-content/70 mb-4">
              Import the official RubyGems.org database dump (~900MB). Includes accurate release dates for all gems.
            </p>
            <%= form_with url: import_baseline_admin_settings_path, method: :post do %>
              <input type="hidden" name="source" value="rubygems_dump">
              <button type="submit" class="btn btn-secondary btn-sm">
                Import RubyGems Dump
              </button>
            <% end %>
            <p class="text-xs text-base-content/50 mt-2">Takes 10-30 minutes</p>
          </div>
        </div>

        <div class="card bg-base-200">
          <div class="card-body">
            <h3 class="card-title text-lg">CSV Baseline</h3>
            <p class="text-sm text-base-content/70 mb-4">
              Import a pre-built CSV baseline. Fastest option, but requires external baseline file.
            </p>
            <%= form_with url: import_baseline_admin_settings_path, method: :post do %>
              <input type="hidden" name="source" value="csv">
              <button type="submit" class="btn btn-ghost btn-sm">
                Import CSV
              </button>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div class="form-control">
        <label class="label">
          <span class="label-text font-bold">CSV Baseline URL</span>
        </label>
        <input type="url" name="baseline_url" value="<%= @settings[:baseline_url] %>" class="input input-bordered w-full" />
        <label class="label">
          <span class="label-text-alt text-base-content/70">
            URL for CSV baseline (used by Quick Start option).
          </span>
        </label>
      </div>
      <button type="submit" class="btn btn-sm btn-ghost">Update URL</button>
    <% end %>
  </div>
</div>

<div class="card bg-base-100 shadow mt-6">
  <div class="card-body">
    <h2 class="card-title">Import from Gemfile.lock</h2>
    <p class="text-sm text-base-content/70 mb-4">
      Upload your application's Gemfile.lock to import gems and start tracking versions.
    </p>

    <ul class="text-sm text-base-content/70 mb-4 list-disc list-inside space-y-1">
      <li>Gems in your lockfile are immediately marked as <span class="badge badge-success badge-sm">approved</span></li>
      <li>Background jobs fetch metadata and quarantine newer versions</li>
    </ul>

    <%= form_with url: import_lockfile_admin_settings_path, method: :post, multipart: true, class: "flex items-end gap-4" do %>
      <div class="form-control flex-1">
        <input type="file" name="lockfile" accept=".lock" class="file-input file-input-bordered w-full max-w-md" />
      </div>
      <button type="submit" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Import Gems
      </button>
    <% end %>
  </div>
</div>

<div class="card bg-base-100 shadow mt-6">
  <div class="card-body">
    <h2 class="card-title">Storage Information</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
      <div>
        <h3 class="font-bold">Specs Cache</h3>
        <% specs_path = Rails.root.join("storage", "specs") %>
        <% if specs_path.exist? %>
          <p class="text-sm text-base-content/70">
            <%= Dir.glob(specs_path.join("*.gz")).count %> spec files
          </p>
        <% else %>
          <p class="text-sm text-base-content/70">Not initialized</p>
        <% end %>
      </div>
      <div>
        <h3 class="font-bold">Gems Cache</h3>
        <% gems_path = Rails.root.join("storage", "gems") %>
        <% if gems_path.exist? %>
          <% gem_files = Dir.glob(gems_path.join("*.gem")) %>
          <p class="text-sm text-base-content/70">
            <%= gem_files.count %> gems cached
            (<%= number_to_human_size(gem_files.sum { |f| File.size(f) }) %>)
          </p>
        <% else %>
          <p class="text-sm text-base-content/70">Not initialized</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
