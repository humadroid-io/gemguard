<div class="mb-6">
  <div class="text-sm breadcrumbs mb-2">
    <ul>
      <li><%= link_to "Gems", admin_gem_packages_path %></li>
      <li><%= @gem_package.name %></li>
    </ul>
  </div>
  <div class="flex items-start justify-between">
    <div>
      <h1 class="text-3xl font-bold"><%= @gem_package.name %></h1>
      <% if @gem_package.info.present? %>
        <p class="text-base-content/70 mt-2"><%= @gem_package.info %></p>
      <% end %>
      <div class="mt-2 flex gap-2">
        <% if @gem_package.tracked? %>
          <span class="badge badge-primary">Tracked</span>
          <span class="text-sm text-base-content/50">since <%= @gem_package.tracked_at.strftime("%Y-%m-%d") %></span>
        <% else %>
          <span class="badge badge-ghost">Not tracked</span>
        <% end %>
      </div>
    </div>
    <div class="flex gap-2">
      <%= button_to "Refresh from RubyGems", refresh_admin_gem_package_path(@gem_package), method: :post, class: "btn btn-primary" %>
      <%= link_to "View on RubyGems", "https://rubygems.org/gems/#{@gem_package.name}", target: "_blank", class: "btn btn-ghost" %>
    </div>
  </div>
</div>

<% unless SpecsAvailabilityService.available? %>
  <div class="alert alert-warning mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div>
      <h3 class="font-bold">Specs not synced</h3>
      <p class="text-sm"><%= SpecsAvailabilityService.status_message %> Approve/block actions are disabled until specs are available.</p>
    </div>
  </div>
<% end %>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Total Versions</div>
    <div class="stat-value"><%= @versions.count %></div>
  </div>

  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Downloads</div>
    <div class="stat-value"><%= number_with_delimiter(@gem_package.downloads_count || 0) %></div>
  </div>

  <div class="stat bg-base-100 rounded-box shadow">
    <div class="stat-title">Homepage</div>
    <div class="stat-value text-lg">
      <% if (safe_url = safe_external_url(@gem_package.homepage_url)) %>
        <%= link_to truncate(safe_url.gsub(%r{https?://}, ""), length: 25), safe_url, target: "_blank", rel: "noopener noreferrer", class: "link link-primary" %>
      <% else %>
        <span class="text-base-content/50">-</span>
      <% end %>
    </div>
  </div>
</div>

<div class="card bg-base-100 shadow">
  <div class="card-body">
    <h2 class="card-title">Versions</h2>
  </div>
  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Version</th>
          <th>Platform</th>
          <th>Status</th>
          <th>Published</th>
          <th>First Seen</th>
          <th>Cached</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @versions.each do |version| %>
          <tr class="hover">
            <td>
              <span class="font-mono font-bold"><%= version.version %></span>
            </td>
            <td>
              <span class="badge badge-ghost"><%= version.platform %></span>
            </td>
            <td>
              <% case version.status %>
              <% when "quarantined" %>
                <span class="badge badge-warning">Quarantined</span>
                <% if version.actively_quarantined? %>
                  <span class="text-xs text-base-content/50 block mt-1">
                    Active
                  </span>
                <% else %>
                  <span class="text-xs text-base-content/50 block mt-1">
                    Expired
                  </span>
                <% end %>
              <% when "approved" %>
                <span class="badge badge-success">Approved</span>
              <% when "blocked" %>
                <span class="badge badge-error">Blocked</span>
              <% end %>
            </td>
            <td class="text-sm">
              <% if version.published_at.present? %>
                <%= version.published_at.strftime("%Y-%m-%d %H:%M") %>
              <% else %>
                <span class="text-base-content/50">-</span>
              <% end %>
            </td>
            <td class="text-sm">
              <%= version.first_seen_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td>
              <% if version.cached? %>
                <span class="badge badge-info badge-sm">Cached</span>
                <% if version.file_size.present? %>
                  <span class="text-xs text-base-content/50 block"><%= number_to_human_size(version.file_size) %></span>
                <% end %>
              <% else %>
                <span class="text-base-content/50">-</span>
              <% end %>
            </td>
            <td>
              <div class="flex gap-1">
                <% if SpecsAvailabilityService.available? %>
                  <% unless version.approved? %>
                    <%= button_to "Approve", approve_version_admin_gem_package_path(@gem_package, version_id: version.id), method: :post, class: "btn btn-success btn-xs" %>
                  <% end %>
                  <% unless version.blocked? %>
                    <%= button_to "Block", block_version_admin_gem_package_path(@gem_package, version_id: version.id), method: :post, class: "btn btn-error btn-xs", data: { confirm: "Are you sure you want to block this version?" } %>
                  <% end %>
                <% else %>
                  <span class="text-base-content/50 text-xs">Sync specs first</span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @versions.empty? %>
    <div class="p-8 text-center text-base-content/70">
      <p>No versions tracked yet.</p>
    </div>
  <% end %>
</div>
