<%- headers = ["Requested At", "Action", "Gem Name", "Version", "IP Address", "User Agent", "Bundler Version"] -%>
<%= headers.join(",") %>
<% @audit_logs.find_each do |log| -%>
<%= [
  log.requested_at.iso8601,
  log.action,
  log.gem_name,
  log.version,
  log.ip_address,
  log.user_agent&.gsub(",", ";"),
  log.bundle_version
].map { |v| "\"#{v}\"" }.join(",") %>
<% end -%>
